{
  "name": "dsh-approval-gate-plus",
  "version": "0.6.1",
  "description": "DeepSeek Harness 自动审批门控（dsh-approval-gate 的增强分支）：Flash 模型预判写入/命令是否不可回补，安全自动批准、危险转人工（fail-safe），最小人工介入；含判定模型路由、中英双语 UI 与人工审查界面。",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client.js",
    "locale/*.json",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --check src/index.mjs && node --check client.js && node scripts/check-manifest.mjs",
    "check:manifest": "node scripts/check-manifest.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-client",
    "approval",
    "auto-approve",
    "审批",
    "自动审批"
  ],
  "license": "MIT",
  "author": "sny1005",
  "contributors": [
    {
      "name": "moon09300731",
      "url": "https://github.com/moon09300731/dsh-approval-gate"
    }
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-0 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sny1005/dsh-approval-gate.git"
  },
  "homepage": "https://github.com/sny1005/dsh-approval-gate#readme",
  "bugs": {
    "url": "https://github.com/sny1005/dsh-approval-gate/issues"
  }
}
